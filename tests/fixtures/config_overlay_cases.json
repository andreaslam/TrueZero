{
  "_comment": "truezero.toml overlay cases shared by src/rust/runconfig.rs and tests/test_run_config.py: both sides must give the same verdict. 'expect' lists [table, key, value] of the effective settings.",
  "cases": [
    {"name": "empty file = all defaults", "user": "", "ok": true,
     "expect": [["selfplay", "max_nodes", 1600], ["server", "port", 38475], ["net", "blocks", 10]]},
    {"name": "only changed keys; integer for a number", "user": "[selfplay]\nroot_pst = 1\nvirtual_leaves = 4\n", "ok": true,
     "expect": [["selfplay", "root_pst", 1.0], ["selfplay", "virtual_leaves", 4], ["selfplay", "max_nodes", 1600]]},
    {"name": "unknown key", "user": "[selfplay]\nmax_node = 1600\n", "ok": false},
    {"name": "string for an integer", "user": "[selfplay]\nmax_nodes = \"1600\"\n", "ok": false},
    {"name": "number for an integer", "user": "[selfplay]\nmax_nodes = 1.5\n", "ok": false},
    {"name": "unknown table", "user": "[extra]\nx = 1\n", "ok": false},
    {"name": "probability out of range", "user": "[selfplay]\npcr_full_prob = 2.0\n", "ok": false},
    {"name": "unknown architecture", "user": "[net]\narch = \"ResNet\"\n", "ok": false},
    {"name": "bad run name", "user": "[run]\nname = \"a/b\"\n", "ok": false},
    {"name": "PCR off", "user": "[selfplay]\npcr_full_prob = 1.0\n", "ok": true,
     "expect": [["selfplay", "pcr_full_prob", 1.0]]},
    {"name": "small net", "user": "[net]\narch = \"TrueNetXS\"\nblocks = 6\nchannels = 64\n", "ok": true,
     "expect": [["net", "arch", "TrueNetXS"], ["net", "channels", 64]]}
  ]
}
